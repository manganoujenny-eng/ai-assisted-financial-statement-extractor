# Copy to .env and fill in. .env is git-ignored — keep it that way.
# NFR-04: an API key pushed to a public repository is found within minutes.

# memory (default, nothing to install) | sql
STORAGE=memory
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/financial_analysis

# rule_based (default, free, deterministic) | llm
STRUCTURER=rule_based
# ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5
# NFR-08: a hard cap, not a good intention.
MAX_COST_USD=5.00

CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=50
