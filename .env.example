# Copy to .env and fill in. .env is git-ignored — keep it that way.
# NFR-04: an API key pushed to a public repository is found within minutes.
# Every variable is optional; the value shown is the default unless noted.

# --- storage -------------------------------------------------------------
# memory (nothing kept after a restart) | sql
STORAGE=memory
# With STORAGE=sql and no DATABASE_URL: SQLite in data/prototype.db.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME

# --- sign-in -------------------------------------------------------------
# true (default) | false (tests or a quick local demo only)
AUTH_REQUIRED=true
# Signs the session cookie. Without it everyone is signed out at each restart.
# Make one with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# --- extraction ----------------------------------------------------------
# rule_based (free, deterministic) | llm (Claude reads the figures)
STRUCTURER=rule_based
# Pages OCR'd in parallel (default: number of CPUs - 1, at most 4)
# OCR_WORKERS=2

# --- language model (structurer and AI commentary) -----------------------
# ANTHROPIC_API_KEY=
# Claude Opus 5.5 — https://platform.claude.com/docs/en/models/overview
MODEL=claude-opus-5-5
# USD per million tokens (Opus 5.5: $4 in / $20 out; thinking is billed as output)
INPUT_USD_PER_MTOK=4.00
OUTPUT_USD_PER_MTOK=20.00
# low | medium | high | xhigh | max — how much the model thinks before answering
LLM_EFFORT=medium
# NFR-08: a hard cap on spending since the backend started, not a good intention.
MAX_COST_USD=5.00
# Cached answers, so the same call is never paid twice.
# Default: <project>/data/llm_cache. Give a full path to change it.
# LLM_CACHE_DIR=

# --- AI commentary on validated analyses ---------------------------------
# llm (needs ANTHROPIC_API_KEY) | off
AI_ANALYSIS=llm
# By default the same model and prices as above:
# ANALYSIS_MODEL=claude-opus-5-5
# ANALYSIS_INPUT_USD_PER_MTOK=4.00
# ANALYSIS_OUTPUT_USD_PER_MTOK=20.00

# --- files ---------------------------------------------------------------
# Uploaded files. Default: <project>/data/uploads. Full path to change it.
# UPLOAD_DIR=
MAX_UPLOAD_MB=300
# The evaluation corpus, one folder per package.
# Default: <project>/data/corpus. Full path to change it.
# CORPUS_DIR=

# --- development ---------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
